{
  "name": "canvasight-plugin",
  "version": "0.6.20",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:mcp": "node scripts/build-mcp.mjs",
    "check:mcp-bundle": "node scripts/build-mcp.mjs --check",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/prepare-release.mjs --check",
    "dev": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:foreground": "vite --host 127.0.0.1",
    "daemon": "node mcp/server.mjs --daemon",
    "daemon:stop": "node mcp/server.mjs --stop-daemon",
    "build": "npm run build:mcp && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:architecture": "node tests/architecture-boundaries.mjs",
    "test:core": "npm run test:architecture && npm run test:unit && npm run test:markdown && npm run test:rich-text && npm run test:asset-presentation && npm run test:node-creation && npm run test:task-attachments && npm run test:single-parent && npm run test:svg-asset && npm run test:concurrency && npm run test:node-executable && npm run test:history-r0 && npm run test:history-host-r0 && npm run test:history-git-r0 && npm run test:project-git-topology && npm run test:history-portability-r0 && npm run test:history-domain && npm run test:history-core && npm run test:history-api && npm run test:history-hook && npm run test:history-host-action && npm run test:history-release && npm run test:history-agent-check && npm run test:history-portability-service && npm run test:history-external-watcher && npm run test:widget-runtime && npm run test:widget-session-recovery",
    "verify": "npm run check:mcp-bundle && npm run typecheck && npm run test:core",
    "preview": "vite preview --host 127.0.0.1",
    "test:dev-server": "node tests/dev-server-smoke.mjs",
    "test:markdown": "node tests/markdown-flow-smoke.mjs",
    "test:rich-text": "node tests/rich-text-smoke.mjs",
    "test:markdown-export": "node tests/markdown-export-smoke.mjs",
    "test:asset-presentation": "node tests/asset-presentation-smoke.mjs",
    "test:node-creation": "node tests/node-creation-menu-smoke.mjs",
    "test:task-attachments": "node tests/task-attachment-entry-smoke.mjs",
    "test:skills": "node tests/skills-smoke.mjs",
    "test:mcp": "node tests/mcp-smoke.mjs",
    "test:concurrency": "node tests/concurrent-document-smoke.mjs",
    "test:node-executable": "node tests/node-executable-candidates-smoke.mjs",
    "test:single-parent": "node tests/single-parent-edge-smoke.mjs",
    "test:svg-asset": "node tests/svg-asset-smoke.mjs",
    "test:update": "node --test tests/update-canvasight-smoke.mjs",
    "test:plugin-distribution": "node tests/plugin-distribution-smoke.mjs",
    "diagnose:mcp": "node tests/mcp-registration-probe.mjs",
    "test:widget-runtime": "node --experimental-websocket tests/widget-runtime-smoke.mjs",
    "test:widget-session-recovery": "node tests/widget-session-recovery-smoke.mjs",
    "test:render-performance": "node --experimental-websocket tests/render-performance-smoke.mjs",
    "test:history-r0": "node tests/project-history-r0-smoke.mjs",
    "test:history-host-r0": "node tests/project-history-host-r0-smoke.mjs",
    "test:history-git-r0": "node tests/project-history-git-r0-smoke.mjs",
    "test:project-git-topology": "node tests/project-git-topology-smoke.mjs",
    "test:history-portability-r0": "node tests/project-history-portability-r0-smoke.mjs",
    "test:history-domain": "vitest run mcp/domain/project-history-domain.test.mjs",
    "test:history-core": "node tests/project-history-core-smoke.mjs",
    "test:history-api": "node tests/project-history-api-smoke.mjs",
    "test:history-hook": "node tests/project-history-hook-smoke.mjs",
    "test:history-host-action": "node tests/project-history-host-action-smoke.mjs",
    "test:history-release": "node tests/project-history-release-smoke.mjs",
    "test:history-portability-service": "node tests/project-history-portability-service-smoke.mjs",
    "test:history-external-watcher": "node tests/project-history-external-watcher-smoke.mjs",
    "test:history-agent-check": "node tests/project-history-agent-check-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-blockquote": "3.28.0",
    "@tiptap/extension-bold": "3.28.0",
    "@tiptap/extension-bubble-menu": "3.28.0",
    "@tiptap/extension-bullet-list": "3.28.0",
    "@tiptap/extension-code": "3.28.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-document": "3.28.0",
    "@tiptap/extension-dropcursor": "3.28.0",
    "@tiptap/extension-floating-menu": "3.28.0",
    "@tiptap/extension-gapcursor": "3.28.0",
    "@tiptap/extension-hard-break": "3.28.0",
    "@tiptap/extension-heading": "3.28.0",
    "@tiptap/extension-horizontal-rule": "3.28.0",
    "@tiptap/extension-italic": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-list-item": "3.28.0",
    "@tiptap/extension-list-keymap": "3.28.0",
    "@tiptap/extension-ordered-list": "3.28.0",
    "@tiptap/extension-paragraph": "3.28.0",
    "@tiptap/extension-placeholder": "3.28.0",
    "@tiptap/extension-strike": "3.28.0",
    "@tiptap/extension-text": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "@tiptap/extensions": "3.28.0",
    "@tiptap/markdown": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@xyflow/react": "^12.9.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "nanoid": "^5.1.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@tiptap/core": "$@tiptap/core",
    "@tiptap/extension-list": "$@tiptap/extension-list",
    "@tiptap/extensions": "$@tiptap/extensions",
    "@tiptap/pm": "$@tiptap/pm"
  }
}
