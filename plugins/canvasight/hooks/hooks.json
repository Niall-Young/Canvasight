{
  "description": "Reserve active Codex turns and capture completed turns as Canvasight Project History recovery points.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/project-history-stop.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\project-history-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/project-history-stop.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\project-history-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "Saving Canvasight project history"
          }
        ]
      }
    ]
  }
}
